{
  "app": "torob-api",
  "platform": "docker",
  "port": 8000,
  "healthCheck": {
    "command": "CMD python -c \"import urllib.request; urllib.request.urlopen('http://localhost:8000/health', timeout=10)\" || exit 1",
    "interval": 30,
    "timeout": 15,
    "retries": 3,
    "startPeriod": 10
  }
}
