{
  "app": "torob-web",
  "platform": "docker",
  "port": 3000,
  "build": {
    "args": ["API_URL=http://torob-api:8000"]
  },
  "healthCheck": {
    "command": "CMD node -e \"fetch('http://localhost:3000/').then(r => process.exit(r.ok ? 0 : 1), () => process.exit(1))\" || exit 1",
    "interval": 30,
    "timeout": 15,
    "retries": 3,
    "startPeriod": 20
  }
}
