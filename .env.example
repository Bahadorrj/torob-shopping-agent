# Copy to .env (gitignored). Compose passes it to the app container; every key is optional.
# Without LLM_API_KEY / NESHAN_API_KEY the app runs degraded and search still works.

LLM_API_KEY=
LLM_BASE_URL=https://ai.boxapi.ir/ai/v1
EMBEDDING_MODEL=text-embedding-3-small
# must match the vectors already ingested
EMBEDDING_DIMENSIONS=512
NESHAN_API_KEY=

# Liara deploy only (docs/runbook.md); not read by the app. Database name: pasazhgard.
# public URI: for the data load, while public access is on
LIARA_DB_PUBLIC_URL=
# private URI: becomes DATABASE_URL on torob-api
LIARA_DB_PRIVATE_URL=
